# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API Keys.
# .env.local is git-ignored, so the real values never reach GitHub.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secrets (never prefixed with VITE_, never in this file's real copy):
# set them with `npx supabase secrets set NAME=value`; the Monobank Edge Function reads them.
#   CRON_SECRET — shared with the pg_cron job (Vault secret `monobank_cron_secret`) so only it can run the daily sync.
