# `npx convex dev` writes these to .env.local (git-ignored) when you connect your Convex account;
# see convex/README.md. The URLs are public by design: every Convex function checks the signed-in user.
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Server-only secrets (Google, sign-in keys) never go here: they live on the Convex
# deployment, set with `npx convex env set NAME value`.
